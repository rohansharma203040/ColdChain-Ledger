# ==============================================================================
# ColdChain Ledger — Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# For Render deployment, configure these environment variables in your Render
# Web Service dashboard under "Environment" -> "Environment Variables".
#
# NOTE: Never commit real .env files, private keys, or passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SECURITY (REQUIRED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Flask application secret key used for session signing and cryptographic operations.
# Generate a strong 32-byte secret, e.g. using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string

# JWT signing secret key used for access token generation and authentication.
# Must be at least 32 characters long to avoid InsecureKeyLengthWarning (RFC 7518).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-different-secure-random-32-byte-hex-string

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND ACCESS (REQUIRED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins permitted to communicate with /api/*.
# Include your deployed Render/Vercel frontend domain as well as local development URLs.
ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Database connection URL.
#
# Option A — Render PostgreSQL (Recommended for production):
#   Set to the Internal Database URL provided by Render Postgres:
#   DATABASE_URL=postgresql://user:password@dpg-xxxxxx-a:5432/coldchain_db
#
# Option B — Render Persistent Disk with SQLite:
#   NOTE: SQLite data will be WIPED on every deploy or restart on Render's ephemeral disk.
#   To persist SQLite, attach a Render Persistent Disk (e.g. mounted at /var/data):
#   DATABASE_URL=sqlite:////var/data/coldchain.db
#
# Option C — Local SQLite development (default fallback if unset):
DATABASE_URL=sqlite:///coldchain.db

# ------------------------------------------------------------------------------
# 4. CRYPTOGRAPHIC SIGNING KEYS (ED25519)
# ------------------------------------------------------------------------------
# ColdChain Ledger signs dataset manifests using Ed25519 digital signatures.
#
# Local development default:
#   Keys are loaded from or auto-generated into backend/keys/
SIGNING_KEYS_DIR=keys
SIGNING_PRIVATE_KEY_FILE=keys/signing_key.pem
SIGNING_PUBLIC_KEY_FILE=keys/signing_key_pub.pem

# Render production recommendation:
#   Use Render "Secret Files" (mounted at /etc/secrets) so private keys are never in Git:
#   SIGNING_PRIVATE_KEY_FILE=/etc/secrets/signing_key.pem
#   SIGNING_PUBLIC_KEY_FILE=/etc/secrets/signing_key_pub.pem

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL DELIVERY (OPTIONAL)
# ------------------------------------------------------------------------------
# Configures automated dispatch of PDF verification reports via SMTP.
# If SMTP_HOST is omitted or empty, the backend operates normally; the email endpoint
# (/api/reports/<shipment_id>/email) returns a descriptive "SMTP_NOT_CONFIGURED" status.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@coldchainledger.internal
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# 6. RUNTIME & SERVER SETTINGS
# ------------------------------------------------------------------------------
# Environment mode. Setting to 'production' disables debug mode when running run.py.
FLASK_ENV=production

# Server listening port.
# Render automatically injects the PORT environment variable (typically 10000).
PORT=5000
HOST=0.0.0.0

# Ensure Python outputs stdout/stderr directly to Render's streaming log viewer
PYTHONUNBUFFERED=1

# ------------------------------------------------------------------------------
# 7. BLOCKCHAIN SETTINGS (STATUS: NOT CURRENTLY READ BY BACKEND CODE)
# ------------------------------------------------------------------------------
# NOTE: The current backend stores blockchain transaction hashes and dataset
# fingerprints in the `blockchain_commitments` database table and supports demo mode
# (is_demo=True). The backend code does not currently read BLOCKCHAIN_RPC_URL or
# talk directly to an EVM network. If live on-chain anchoring is implemented in the
# future, Web3 integration and the following variables will be required:
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/your-api-key
# BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
